{
  "name": "backend",
  "author": "NRIDS",
  "license": "Apache-2.0",
  "main": "index.js",
  "scripts": {
    "prisma-generate": "prisma generate",
    "prebuild": "rimraf dist",
    "build": "prisma generate && nest build",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "deploy": "npm ci --ignore-scripts --no-update-notifier && npm run build",
    "prestart": "prisma generate",
    "start": "nest start",
    "prestart:dev": "prisma generate",
    "start:dev": "nest start --watch",
    "prestart:debug": "prisma generate",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:openapi": "spectral lint openapi/widgets.openapi.yaml --ruleset .spectral.yaml",
    "generate:openapi": "npm run build && node scripts/generate-openapi.cjs",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "make-badges": "istanbul-badges-readme --logo=vitest --exitCode=1",
    "make-badges:ci": "npm run make-badges -- --ci",
    "pretest": "prisma generate",
    "test": "vitest --dir src",
    "test:cov": "prisma generate && vitest run --coverage",
    "pretest:e2e": "prisma generate",
    "test:e2e": "vitest --dir test"
  },
  "dependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/common": "^11.0.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.6",
    "@nestjs/platform-express": "^11.0.6",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/testing": "^11.0.6",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "express-prom-bundle": "^8.0.0",
    "helmet": "^8.0.0",
    "nest-winston": "^1.10.1",
    "pg": "^8.13.1",
    "prisma": "^7.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.16.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.10.12",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.2.3",
    "istanbul-badges-readme": "^1.9.0",
    "magicast": "^0.5.2",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.58.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "c12": ">=3.3.4 <4",
    "@hono/node-server": "<3"
  }
}
