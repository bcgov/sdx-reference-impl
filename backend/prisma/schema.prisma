generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// NOTE: The datasource URL is now configured in prisma.config.ts (Prisma 7+).
// This file no longer contains the `url` field for the datasource.
datasource db {
  provider = "postgresql"
  schemas  = ["users"]
}

model users {
  id    Decimal @id(map: "USER_PK") @default(dbgenerated("nextval('\"USER_SEQ\"'::regclass)")) @db.Decimal
  name  String  @db.VarChar(200)
  email String  @db.VarChar(200)

  @@schema("users")
}

model SdxWidget {
  id          String   @id @default(uuid()) @db.Uuid
  subject     String   @db.VarChar(255)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(1000)
  status      String   @default("active") @db.VarChar(20)
  metadata    Json     @default("{}") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  idempotencyRecords SdxWidgetIdempotency[]

  @@index([subject], map: "SDX_WIDGET_SUBJECT_IDX")
  @@map("SDX_WIDGETS")
  @@schema("users")
}

model SdxWidgetIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  subject        String   @db.VarChar(255)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  widgetId       String   @map("widget_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  widget SdxWidget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([subject, idempotencyKey], map: "SDX_WIDGET_IDEMPOTENCY_UQ")
  @@index([widgetId], map: "SDX_WIDGET_IDEMPOTENCY_WIDGET_ID_IDX")
  @@map("SDX_WIDGET_IDEMPOTENCY")
  @@schema("users")
}
