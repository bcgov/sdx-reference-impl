generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// NOTE: The datasource URL is now configured in prisma.config.ts (Prisma 7+).
// This file no longer contains the `url` field for the datasource.
datasource db {
  provider = "postgresql"
  schemas  = ["widgets"]
}

model Widget {
  id             String   @id @default(uuid()) @db.Uuid
  subject        String   @db.VarChar(255)
  name           String   @db.VarChar(200)
  description    String?  @db.VarChar(1000)
  status         String   @default("active") @db.VarChar(20)
  additionalData Json     @default("{}") @map("additional_data") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  idempotencyRecords WidgetIdempotency[]

  @@index([subject], map: "WIDGET_SUBJECT_IDX")
  @@map("widgets")
  @@schema("widgets")
}

model WidgetIdempotency {
  id             String   @id @default(uuid()) @db.Uuid
  subject        String   @db.VarChar(255)
  idempotencyKey String   @map("idempotency_key") @db.VarChar(255)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  widgetId       String   @map("widget_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([subject, idempotencyKey], map: "WIDGET_IDEMPOTENCY_UQ")
  @@index([widgetId], map: "WIDGET_IDEMPOTENCY_WIDGET_ID_IDX")
  @@map("widget_idempotency")
  @@schema("widgets")
}

model User {
  subject     String   @id @db.VarChar(255)
  displayName String   @map("display_name") @db.VarChar(255)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
  @@schema("widgets")
}
